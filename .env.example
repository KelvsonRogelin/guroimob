# ============================================================
# Guru Imob — modelo de configuração
# Copie para ".env" e preencha os valores.
#   Windows:      copy .env.example .env
#   Linux/macOS:  cp .env.example .env
# ============================================================

# ----- Aplicação -----
APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_SECRET=troque-por-uma-chave-aleatoria

# ----- Conta administradora (criada no 1º start) -----
ADMIN_EMAIL=admin@exemplo.local
ADMIN_PASS=admin
ADMIN_NOME=Administrador

# ----- Filtros padrão da captura -----
CIDADE=Joinville
ESTADO=sc
BAIRROS=Centro,América,Atiradores
TIPO_IMOVEL=apartamento
MIN_QUARTOS=2
MIN_AREA=50
PRECO_LIMITE_M2=10000

# ----- Google Sheets (opcional) -----
GOOGLE_SHEET_ID=
SHEET_NAME=ImoveisBaratos
GOOGLE_CREDENTIALS_FILE=

# ----- WhatsApp Cloud API (opcional) -----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# ----- Suporte por e-mail / SMTP (opcional) -----
# Gmail: use uma "senha de app" (16 caracteres) em SMTP_PASS.
SUPPORT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ----- Compatibilidade (credenciais legadas) -----
AUTH_USER=admin
AUTH_PASS=admin
